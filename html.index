<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maryoma Dresses | أتيليه مريومة دريسز - تواصلي معنا</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Amiri, Tajawal, and Cormorant Garamond for Luxury Branding -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,600;0,700;1,600&family=Tajawal:wght@300;400;500;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Tajawal', 'sans-serif'],
                        serifAr: ['Amiri', 'serif'],
                        brand: ['Cormorant Garamond', 'serif'],
                    },
                    colors: {
                        champagne: {
                            50: '#FDFBF7',
                            100: '#F9F3EA',
                            200: '#F0E1CC',
                            300: '#E5C9A6',
                            400: '#D6AE7B',
                            500: '#C59356',
                            600: '#A8763E',
                        },
                        velvet: {
                            800: '#2A1822',
                            900: '#1D0F17',
                            950: '#14090F',
                        },
                        whatsapp: {
                            500: '#25D366',
                            600: '#1EBE5D',
                            700: '#128C7E',
                        }
                    },
                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                        'shimmer': 'shimmer 2.5s linear infinite',
                        'pulse-glow': 'pulseGlow 2.5s infinite',
                        'sparkle': 'sparkle 3s ease-in-out infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-8px)' },
                        },
                        shimmer: {
                            '0%': { backgroundPosition: '-200% 0' },
                            '100%': { backgroundPosition: '200% 0' },
                        },
                        pulseGlow: {
                            '0%, 100%': { boxShadow: '0 0 0 0 rgba(37, 211, 102, 0.55)' },
                            '50%': { boxShadow: '0 0 0 14px rgba(37, 211, 102, 0)' },
                        },
                        sparkle: {
                            '0%, 100%': { opacity: '0.2', transform: 'scale(0.8)' },
                            '50%': { opacity: '1', transform: 'scale(1.2)' },
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom luxury scrollbar & background textures */
        body {
            background-color: #14090F;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(214, 174, 123, 0.14) 0%, transparent 45%),
                radial-gradient(circle at 85% 80%, rgba(168, 118, 62, 0.16) 0%, transparent 50%),
                linear-gradient(180deg, #1D0F17 0%, #14090F 100%);
            color: #FDFBF7;
            overflow-x: hidden;
        }

        .glass-card {
            background: rgba(42, 24, 34, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(229, 201, 166, 0.22);
        }

        .gold-gradient-text {
            background: linear-gradient(135deg, #F9F3EA 0%, #E5C9A6 45%, #C59356 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .shimmer-btn {
            background: linear-gradient(110deg, #1EBE5D 0%, #25D366 45%, #5CE68D 50%, #25D366 55%, #128C7E 100%);
            background-size: 200% 100%;
            animation: shimmer 3s linear infinite, pulseGlow 2.5s infinite;
        }

        .chip-active {
            background: linear-gradient(135deg, rgba(214, 174, 123, 0.28) 0%, rgba(197, 147, 86, 0.18) 100%);
            border-color: #E5C9A6;
            color: #FDFBF7;
            box-shadow: 0 4px 20px -2px rgba(214, 174, 123, 0.25);
        }

        /* Subtle decorative sparkles */
        .sparkle-dot {
            position: absolute;
            border-radius: 9999px;
            background: radial-gradient(circle, #F9F3EA 0%, rgba(229, 201, 166, 0) 70%);
            pointer-events: none;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-champagne-400 selection:text-velvet-950">

    <!-- Decorative Ambient Sparkles -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
        <div class="sparkle-dot w-2 h-2 top-16 right-[15%] animate-sparkle"></div>
        <div class="sparkle-dot w-3 h-3 top-40 left-[12%] animate-sparkle" style="animation-delay: 1s;"></div>
        <div class="sparkle-dot w-1.5 h-1.5 top-[55%] right-[8%] animate-sparkle" style="animation-delay: 1.8s;"></div>
        <div class="sparkle-dot w-2.5 h-2.5 bottom-32 left-[20%] animate-sparkle" style="animation-delay: 0.6s;"></div>
    </div>

    <!-- Main Container -->
    <main class="relative z-10 w-full max-w-xl mx-auto px-4 pt-8 pb-28 sm:pt-12">
        
        <!-- Top Status Pill -->
        <div class="flex justify-center mb-6">
            <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full glass-card text-xs sm:text-sm text-champagne-100 shadow-lg">
                <span class="relative flex h-2.5 w-2.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-whatsapp-500 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-whatsapp-500"></span>
                </span>
                <span>متاحون الآن للرد الفوري على استفساراتكِ</span>
            </div>
        </div>

        <!-- Hero Section: Luxury Atelier Crest & Branding -->
        <header class="text-center mb-8">
            <!-- Custom SVG Haute Couture Dress & Crown Crest -->
            <div class="relative w-28 h-28 mx-auto mb-5 flex items-center justify-center animate-float">
                <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-champagne-500/20 via-champagne-300/10 to-transparent blur-xl"></div>
                <div class="relative w-24 h-24 rounded-full glass-card border border-champagne-300/40 flex items-center justify-center shadow-2xl">
                    <svg class="w-14 h-14 text-champagne-300" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Delicate Crown -->
                        <path d="M23 14L26.5 18.5L32 13L37.5 18.5L41 14L39.5 21H24.5L23 14Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                        <!-- Bodice -->
                        <path d="M26 25C26 25 28.5 27.5 32 27.5C35.5 27.5 38 25 38 25L36.5 33.5H27.5L26 25Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                        <!-- Flowing Ballgown Skirt -->
                        <path d="M27.5 33.5C21 40 15 48 13 53C19 54.5 25.5 55 32 55C38.5 55 45 54.5 51 53C49 48 43 40 36.5 33.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        <!-- Gown Pleats & Sparkle Lines -->
                        <path d="M30 34C27 41 24 48 22.5 54" stroke="currentColor" stroke-width="1.1" stroke-opacity="0.7" stroke-linecap="round"/>
                        <path d="M34 34C37 41 40 48 41.5 54" stroke="currentColor" stroke-width="1.1" stroke-opacity="0.7" stroke-linecap="round"/>
                        <path d="M32 34V54.5" stroke="currentColor" stroke-width="1.1" stroke-opacity="0.5" stroke-dasharray="2 3"/>
                    </svg>
                </div>
            </div>

            <!-- Brand Title -->
            <h1 class="font-brand text-4xl sm:text-5xl font-bold tracking-wider gold-gradient-text mb-1" dir="ltr">
                Maryoma Dresses
            </h1>
            <p class="font-serifAr text-xl sm:text-2xl text-champagne-200 mb-3">
                أتيليه مريومة دريسز للأزياء الراقية
            </p>
            <p class="text-sm sm:text-base text-champagne-100/80 max-w-md mx-auto leading-relaxed">
                إطلالتكِ الملكية تبدأ من هنا.. صممي فستان أحلامكِ أو اختاري من أحدث تشكيلات الزفاف والخطوبة والسواريه بتفصيل وتطريز يدوي فاخر.
            </p>
        </header>

        <!-- Primary Instant CTA Card -->
        <section class="mb-7">
            <a id="direct-wa-btn" href="https://wa.me/201021686810?text=%D8%A3%D9%87%D9%84%D8%A7%D9%8B%20Maryoma%20Dresses%20%E2%9C%A8%20%D8%AD%D8%A7%D8%A8%D8%A9%20%D8%A3%D8%B3%D8%AA%D9%81%D8%B3%D8%B1%20%D8%B9%D9%86%20%D8%A7%D9%84%D9%81%D8%B3%D8%A7%D8%AA%D9%8A%D9%86%20%D9%88%D8%A7%D9%84%D9%85%D9%88%D8%A7%D8%B9%D9%8A%D8%AF%20%D8%A7%D9%84%D9%85%D8%AA%D8%A7%D8%AD%D8%A9" target="_blank" rel="noopener noreferrer"
               class="shimmer-btn group relative w-full flex items-center justify-between px-6 py-4 rounded-2xl text-white font-bold shadow-2xl transition-transform duration-300 hover:scale-[1.02] active:scale-[0.98]">
                <div class="flex items-center gap-3.5">
                    <div class="w-12 h-12 rounded-xl bg-white/20 backdrop-blur-sm flex items-center justify-center text-2xl shadow-inner">
                        <i class="fa-brands fa-whatsapp"></i>
                    </div>
                    <div class="text-right">
                        <span class="block text-base sm:text-lg font-extrabold leading-tight">تواصلي معنا فوراً عبر واتساب</span>
                        <span class="block text-xs text-white/90 font-normal mt-0.5" dir="ltr">+20 102 168 6810</span>
                    </div>
                </div>
                <div class="w-9 h-9 rounded-full bg-white/15 flex items-center justify-center transition-transform duration-300 group-hover:-translate-x-1">
                    <i class="fa-solid fa-arrow-left text-sm"></i>
                </div>
            </a>
        </section>

        <!-- Interactive Quick Inquiry Builder -->
        <section class="glass-card rounded-3xl p-5 sm:p-7 shadow-2xl mb-7">
            <div class="flex items-center justify-between border-b border-champagne-300/15 pb-4 mb-5">
                <div>
                    <h2 class="text-lg sm:text-xl font-bold text-champagne-100 flex items-center gap-2">
                        <i class="fa-solid fa-wand-magic-sparkles text-champagne-400"></i>
                        <span>جهّزي رسالتكِ بضغطة واحدة</span>
                    </h2>
                    <p class="text-xs text-champagne-200/70 mt-0.5">اختاري تفاصيل طلبكِ وسنجهز لكِ الرسالة فوراً</p>
                </div>
                <button type="button" onclick="resetBuilder()" class="text-xs text-champagne-300 hover:text-white underline underline-offset-4 transition">
                    إعادة ضبط
                </button>
            </div>

            <!-- Step 1: Dress Category -->
            <div class="mb-5">
                <label class="block text-xs sm:text-sm font-semibold text-champagne-200 mb-2.5">
                    1. ما نوع الفستان الذي تبحثين عنه؟
                </label>
                <div class="grid grid-cols-2 gap-2.5" id="dress-type-group">
                    <button type="button" onclick="selectOption('dressType', 'فستان زفاف ملكي 👰🏻‍♀️', this)" 
                            class="chip-btn chip-active flex items-center gap-2.5 p-3 rounded-xl border border-champagne-300/20 bg-velvet-950/50 text-right text-xs sm:text-sm font-medium text-champagne-100/80 transition-all hover:border-champagne-300/50">
                        <span class="text-lg">👰🏻‍♀️</span>
                        <span>فستان زفاف</span>
                    </button>
                    <button type="button" onclick="selectOption('dressType', 'فستان خطوبة / كتب كتاب 💍', this)" 
                            class="chip-btn flex items-center gap-2.5 p-3 rounded-xl border border-champagne-300/20 bg-velvet-950/50 text-right text-xs sm:text-sm font-medium text-champagne-100/80 transition-all hover:border-champagne-300/50">
                        <span class="text-lg">💍</span>
                        <span>فستان خطوبة</span>
                    </button>
                    <button type="button" onclick="selectOption('dressType', 'فستان سهرة سواريه ✨', this)" 
                            class="chip-btn flex items-center gap-2.5 p-3 rounded-xl border border-champagne-300/20 bg-velvet-950/50 text-right text-xs sm:text-sm font-medium text-champagne-100/80 transition-all hover:border-champagne-300/50">
                        <span class="text-lg">✨</span>
                        <span>سهرة سواريه</span>
                    </button>
                    <button type="button" onclick="selectOption('dressType', 'تفصيل تصميم خاص ✂️', this)" 
                            class="chip-btn flex items-center gap-2.5 p-3 rounded-xl border border-champagne-300/20 bg-velvet-950/50 text-right text-xs sm:text-sm font-medium text-champagne-100/80 transition-all hover:border-champagne-300/50">
                        <span class="text-lg">✂️</span>
                        <span>تفصيل خاص</span>
                    </button>
                </div>
            </div>

            <!-- Step 2: Desired Service -->
            <div class="mb-5">
                <label class="block text-xs sm:text-sm font-semibold text-champagne-200 mb-2.5">
                    2. كيف يمكننا مساعدتكِ اليوم؟
                </label>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2" id="service-type-group">
                    <button type="button" onclick="selectOption('serviceType', 'حجز موعد بروفة في الأتيليه', this)" 
                            class="chip-btn chip-active flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl border border-champagne-300/20 bg-velvet-950/50 text-xs font-medium text-champagne-100/80 transition-all hover:border-champagne-300/50">
                        <i class="fa-regular fa-calendar-check text-champagne-400"></i>
                        <span>حجز موعد بروفة</span>
                    </button>
                    <button type="button" onclick="selectOption('serviceType', 'الاستفسار عن الأسعار والموديلات', this)" 
                            class="chip-btn flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl border border-champagne-300/20 bg-velvet-950/50 text-xs font-medium text-champagne-100/80 transition-all hover:border-champagne-300/50">
                        <i class="fa-solid fa-tags text-champagne-400"></i>
                        <span>الأسعار والموديلات</span>
                    </button>
                    <button type="button" onclick="selectOption('serviceType', 'إرسال صورة موديل للتنفيذ', this)" 
                            class="chip-btn flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl border border-champagne-300/20 bg-velvet-950/50 text-xs font-medium text-champagne-100/80 transition-all hover:border-champagne-300/50">
                        <i class="fa-regular fa-image text-champagne-400"></i>
                        <span>إرسال صورة تصميم</span>
                    </button>
                </div>
            </div>

            <!-- Step 3: Optional Name & Event Date -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-5">
                <div>
                    <label for="client-name" class="block text-xs text-champagne-200/80 mb-1.5">الاسم (اختياري)</label>
                    <input type="text" id="client-name" oninput="updateMessagePreview()" placeholder="مثال: سارة أحمد"
                           class="w-full px-3.5 py-2.5 rounded-xl bg-velvet-950/70 border border-champagne-300/20 text-sm text-champagne-50 placeholder-champagne-200/35 focus:outline-none focus:border-champagne-400 transition">
                </div>
                <div>
                    <label for="event-date" class="block text-xs text-champagne-200/80 mb-1.5">موعد المناسبة (اختياري)</label>
                    <input type="text" id="event-date" oninput="updateMessagePreview()" placeholder="مثال: شهر ديسمبر القادم"
                           class="w-full px-3.5 py-2.5 rounded-xl bg-velvet-950/70 border border-champagne-300/20 text-sm text-champagne-50 placeholder-champagne-200/35 focus:outline-none focus:border-champagne-400 transition">
                </div>
            </div>

            <!-- Live WhatsApp Message Preview Box -->
            <div class="rounded-2xl bg-velvet-950/80 border border-champagne-300/15 p-3.5 mb-5">
                <div class="flex items-center justify-between mb-1.5">
                    <span class="text-[11px] font-medium text-champagne-300 flex items-center gap-1.5">
                        <i class="fa-brands fa-whatsapp text-whatsapp-500"></i>
                        معاينة رسالتكِ الجاهزة:
                    </span>
                    <button type="button" onclick="copyMessageText()" class="text-[11px] text-champagne-200/70 hover:text-champagne-100 flex items-center gap-1 transition">
                        <i class="fa-regular fa-copy"></i>
                        <span id="copy-label">نسخ النص</span>
                    </button>
                </div>
                <p id="message-preview" class="text-xs sm:text-sm text-champagne-100/95 leading-relaxed whitespace-pre-line font-normal"></p>
            </div>

            <!-- Custom Message Send Button -->
            <button type="button" onclick="sendCustomWhatsApp()" 
                    class="w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-champagne-500 via-champagne-400 to-champagne-500 text-velvet-950 font-extrabold text-sm sm:text-base shadow-lg hover:brightness-110 active:scale-[0.99] transition-all flex items-center justify-center gap-2.5">
                <i class="fa-brands fa-whatsapp text-xl"></i>
                <span>إرسال هذه الرسالة على واتساب الآن</span>
            </button>
        </section>

        <!-- Luxury Trust Badges / Highlights -->
        <section class="grid grid-cols-3 gap-2.5 sm:gap-3.5 mb-7">
            <div class="glass-card rounded-2xl p-3.5 text-center">
                <div class="w-9 h-9 mx-auto mb-2 rounded-full bg-champagne-400/15 flex items-center justify-center text-champagne-300">
                    <i class="fa-solid fa-gem text-sm"></i>
                </div>
                <h3 class="text-xs sm:text-sm font-bold text-champagne-100">تطريز يدوي</h3>
                <p class="text-[11px] text-champagne-200/70 mt-0.5">أرقى الخامات والكريستال</p>
            </div>
            <div class="glass-card rounded-2xl p-3.5 text-center">
                <div class="w-9 h-9 mx-auto mb-2 rounded-full bg-champagne-400/15 flex items-center justify-center text-champagne-300">
                    <i class="fa-solid fa-ruler-combined text-sm"></i>
                </div>
                <h3 class="text-xs sm:text-sm font-bold text-champagne-100">تفصيل خاص</h3>
                <p class="text-[11px] text-champagne-200/70 mt-0.5">مقاسات دقيقة لقوامكِ</p>
            </div>
            <div class="glass-card rounded-2xl p-3.5 text-center">
                <div class="w-9 h-9 mx-auto mb-2 rounded-full bg-champagne-400/15 flex items-center justify-center text-champagne-300">
                    <i class="fa-solid fa-crown text-sm"></i>
                </div>
                <h3 class="text-xs sm:text-sm font-bold text-champagne-100">تصاميم حصرية</h3>
                <p class="text-[11px] text-champagne-200/70 mt-0.5">أحدث صيحات الكوتور</p>
            </div>
        </section>

        <!-- Quick Phone Copy Bar -->
        <div class="glass-card rounded-2xl px-4 py-3 flex items-center justify-between text-xs sm:text-sm">
            <div class="flex items-center gap-2.5 text-champagne-200">
                <i class="fa-solid fa-phone-volume text-champagne-400"></i>
                <span>رقم الواتساب المباشر:</span>
                <strong class="text-champagne-50 font-bold tracking-wide" dir="ltr">+20 102 168 6810</strong>
            </div>
            <button type="button" onclick="copyPhoneNumber()" class="px-3 py-1.5 rounded-lg bg-champagne-400/20 hover:bg-champagne-400/30 text-champagne-200 text-xs font-semibold transition">
                <span id="copy-phone-label">نسخ الرقم</span>
            </button>
        </div>

    </main>

    <!-- Footer -->
    <footer class="relative z-10 text-center pb-6 text-xs text-champagne-200/50">
        <p>© <span id="year"></span> Maryoma Dresses - أتيليه مريومة دريسز. جميع الحقوق محفوظة.</p>
    </footer>

    <!-- Floating Bottom WhatsApp Button -->
    <a href="https://wa.me/201021686810?text=%D8%A3%D9%87%D9%84%D8%A7%D9%8B%20Maryoma%20Dresses%20%E2%9C%A8" target="_blank" rel="noopener noreferrer"
       aria-label="تواصلي معنا عبر واتساب"
       class="fixed bottom-5 left-5 z-50 flex items-center gap-2.5 bg-whatsapp-500 hover:bg-whatsapp-600 text-white px-4 py-3 rounded-full shadow-2xl animate-pulse-glow transition-transform hover:scale-105">
        <i class="fa-brands fa-whatsapp text-2xl"></i>
        <span class="text-xs sm:text-sm font-bold hidden sm:inline">راسلينا الآن</span>
    </a>

    <!-- Toast Notification Banner (Replaces alert) -->
    <div id="toast" class="fixed top-5 left-1/2 -translate-x-1/2 z-50 opacity-0 pointer-events-none transition-all duration-300 transform -translate-y-3">
        <div class="px-5 py-2.5 rounded-full bg-champagne-100 text-velvet-950 font-bold text-xs sm:text-sm shadow-2xl flex items-center gap-2">
            <i class="fa-solid fa-circle-check text-whatsapp-600"></i>
            <span id="toast-text">تم النسخ بنجاح!</span>
        </div>
    </div>

    <script>
        // Set current year in footer
        document.getElementById('year').textContent = new Date().getFullYear();

        // WhatsApp configuration
        const WHATSAPP_NUMBER = '201021686810';

        // Builder State
        const state = {
            dressType: 'فستان زفاف ملكي 👰🏻‍♀️',
            serviceType: 'حجز موعد بروفة في الأتيليه'
        };

        /**
         * Handles chip selection inside a specific group and updates live preview
         */
        function selectOption(category, value, element) {
            state[category] = value;

            // Update active styling within the parent container
            const container = element.parentElement;
            const buttons = container.querySelectorAll('.chip-btn');
            buttons.forEach(btn => btn.classList.remove('chip-active'));
            element.classList.add('chip-active');

            updateMessagePreview();
        }

        /**
         * Generates the formatted Arabic WhatsApp message from current selections
         */
        function buildMessage() {
            const clientName = document.getElementById('client-name').value.trim();
            const eventDate = document.getElementById('event-date').value.trim();

            let msg = `أهلاً أتيليه Maryoma Dresses ✨\n`;
            if (clientName) {
                msg += `معكم: ${clientName}\n`;
            }
            msg += `• مهتمة بـ: ${state.dressType}\n`;
            msg += `• المطلوب: ${state.serviceType}`;
            if (eventDate) {
                msg += `\n• موعد المناسبة: ${eventDate}`;
            }
            msg += `\n\nفي انتظار ردكم الكريم 🤍`;

            return msg;
        }

        /**
         * Updates the preview box text in real time
         */
        function updateMessagePreview() {
            const previewEl = document.getElementById('message-preview');
            previewEl.textContent = buildMessage();
        }

        /**
         * Opens WhatsApp with the customized pre-filled message
         */
        function sendCustomWhatsApp() {
            const message = buildMessage();
            const encodedMessage = encodeURIComponent(message);
            const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodedMessage}`;
            window.open(url, '_blank', 'noopener,noreferrer');
        }

        /**
         * Resets the inquiry builder back to default options
         */
        function resetBuilder() {
            document.getElementById('client-name').value = '';
            document.getElementById('event-date').value = '';

            const firstDressBtn = document.querySelector('#dress-type-group .chip-btn');
            const firstServiceBtn = document.querySelector('#service-type-group .chip-btn');

            if (firstDressBtn) selectOption('dressType', 'فستان زفاف ملكي 👰🏻‍♀️', firstDressBtn);
            if (firstServiceBtn) selectOption('serviceType', 'حجز موعد بروفة في الأتيليه', firstServiceBtn);

            showToast('تمت إعادة ضبط الاختيارات');
        }

        /**
         * Copies text safely using fallback-compatible execCommand
         */
        function copyToClipboard(text, successMessage) {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand('copy');
                showToast(successMessage);
            } catch (err) {
                showToast('تعذر النسخ، يرجى المحاولة يدوياً');
            }
            document.body.removeChild(textarea);
        }

        function copyMessageText() {
            copyToClipboard(buildMessage(), 'تم نسخ نص الرسالة!');
        }

        function copyPhoneNumber() {
            copyToClipboard('+201021686810', 'تم نسخ رقم الواتساب: +201021686810');
        }

        /**
         * Displays a subtle floating notification banner
         */
        let toastTimeout;
        function showToast(text) {
            const toast = document.getElementById('toast');
            const toastText = document.getElementById('toast-text');
            toastText.textContent = text;

            toast.classList.remove('opacity-0', '-translate-y-3');
            toast.classList.add('opacity-100', 'translate-y-0');

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', '-translate-y-3');
            }, 2500);
        }

        // Initialize preview on load
        window.addEventListener('DOMContentLoaded', updateMessagePreview);
    </script>
</body>
</html>
